# EmoSense Environment Configuration Template
# Copy this file to .env (do NOT commit .env with real credentials)

# When omitted, EmoSense operates seamlessly in local offline reflection mode.
EMOSENSE_AI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-1.5-flash)
# EMOSENSE_AI_MODEL=gemini-1.5-flash
